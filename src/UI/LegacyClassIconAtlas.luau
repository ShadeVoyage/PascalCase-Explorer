local SERVICE_FALLBACK_INDEX = 30

function LegacyClassIconAtlas.Get(className: string, isService: boolean): AtlasIcon?
	local index = INDEX[className]

	if index == nil and isService then
		index = SERVICE_FALLBACK_INDEX
	end

	if index == nil then
		return nil
	end

	return {
		Image = IMAGE,
		ImageRectOffset = Vector2.new(index * 16, 0),
		ImageRectSize = SIZE,
	}
end

return LegacyClassIconAtlas
